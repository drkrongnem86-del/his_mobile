<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml
  v3.0.156: Whitelist IP nội bộ BV (172.16.x.x, 117.2.25.x, 113.163.187.x)
  - Cho phép cleartext HTTP (vì HIS Pro chỉ hỗ trợ HTTP, không HTTPS)
  - Tất cả domain/IP khác: cleartext bị CHẶN (mặc định Android 9+)
  - Trước đây usesCleartextTraffic="true" cho toàn bộ app → security risk
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain whitelist cho HIS Pro internal IPs -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- HIS Pro LAN BV -->
        <domain includeSubdomains="true">172.16.9.6</domain>
        <domain includeSubdomains="true">172.16.200.109</domain>
        <domain includeSubdomains="true">172.16.1.12</domain>
        <!-- HIS Pro VPN -->
        <domain includeSubdomains="true">117.2.25.67</domain>
        <!-- Public Data 3000 + Public 8080 -->
        <domain includeSubdomains="true">113.163.187.3</domain>
        <!-- Localhost (cho PdfRenderer test) -->
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
