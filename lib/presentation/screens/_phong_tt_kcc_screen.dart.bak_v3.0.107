// PhongTTKccScreen v3.0.100+ - "Phòng TT khoa cấp cứu"
// v3.0.100: Tạo mới theo yêu cầu BS Nem - dạng như desktop HIS
// v3.0.104: Debug log + dump response ra file local
// v3.0.105: Fix ROOM_ID 39 → 36 (từ log HIS Pro thật) - vẫn fail HTTP 404 do VPN chặn
// v3.0.106: Dùng Public API thongke (113.163.187.3:8080) giống HomeScreen
// v3.0.107: THÊM NÚT CHỌN API (3 nguồn): Public / HIS Pro 1408 / Proxy 9999
// v3.0.108: BỎ PROXY 9999 + ĐỔI FILTER REQUEST_ROOM_ID=39
//   - Chỉ còn 2 nguồn: Public 8080 (luôn chạy) + HIS Pro 1408 (cần LAN/VPN BV)
//   - Filter theo REQUEST_ROOM_ID = 39 (PTTT_KCC - phòng BS Nem đang chọn từ)
//     thay vì EXECUTE_ROOM_ID = 36 (PKCC - phòng khám BN sẽ chuyển tới)

import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:his_mobile/core/services/phong_tt_api_sources.dart';
import 'package:his_mobile/data/api/y_te_so_service.dart';
import 'package:his_mobile/presentation/navigation/safe_navigator.dart';
import 'package:path_provider/path_provider.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:syncfusion_flutter_pdfviewer/pdfviewer.dart';

/// Màn hình Phòng TT khoa cấp cứu
class PhongTTKccScreen extends StatefulWidget {
  final int deptCatalogId;
  final String roomName;
  const PhongTTKccScreen({
    super.key,
    this.deptCatalogId = 22,
    this.roomName = 'Phòng TT Khoa Cấp Cứu',
  });

  @override
  State<PhongTTKccScreen> createState() => _PhongTTKccScreenState();
}

class _PhongTTKccScreenState extends State<PhongTTKccScreen> {
  static const _kApiSourcePref = 'phong_tt_kcc_api_source';
  PhongTTApiSource _selectedSource = PhongTTApiSource.public8080;
  bool _loading = false;
  String? _error;
  List<Map<String, dynamic>> _allPatients = [];
  String _searchQuery = '';
  final TextEditingController _searchCtrl = TextEditingController();
  String? _apiSource;        // hiển thị API đang dùng
  DateTime? _lastSynced;     // thời gian sync cuối
  String? _lastApiUrl;       // URL gọi

  @override
  void initState() {
    super.initState();
    _loadSavedSource();
  }

  Future<void> _loadSavedSource() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final saved = prefs.getString(_kApiSourcePref);
      if (saved != null) {
        _selectedSource = PhongTTApiSource.values.firstWhere(
          (e) => e.name == saved,
          orElse: () => PhongTTApiSource.public8080,
        );
      }
    } catch (_) {}
    _loadData();
  }

  Future<void> _saveSource(PhongTTApiSource s) async {
    try {
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString(_kApiSourcePref, s.name);
    } catch (_) {}
  }

  @override
  void dispose() {
    _searchCtrl.dispose();
    super.dispose();
  }

  Future<void> _loadData() async {
    setState(() {
      _loading = true;
      _error = null;
    });

    try {
      debugPrint('🔍 [PHONG_TT_KCC] load from ${_selectedSource.label}');
      final res = await PhongTTApiService.instance.loadPatients(
        source: _selectedSource,
        requestRoomId: 39,    // v3.0.108: PTTT_KCC
        executeRoomId: 36,    // PKCC (reference)
        deptCatalogId: widget.deptCatalogId,
      );

      debugPrint('🔍 [PHONG_TT_KCC] result: success=${res.success} count=${res.patients.length} msg=${res.message}');
      if (res.patients.isNotEmpty) {
        debugPrint('🔍 [PHONG_TT_KCC] first BN: ${res.patients.first}');
      }
      await _dumpResponseToFile(res);

      if (mounted) {
        setState(() {
          _allPatients = res.patients;
          _apiSource = res.success
              ? '${_selectedSource.label} → ${res.patients.length} BN'
              : '❌ ${_selectedSource.shortLabel}: ${res.message}';
          _lastApiUrl = res.apiUrl;
          _lastSynced = res.loadedAt;
          _error = res.success ? null : res.message;
          _loading = false;
        });
      }
    } catch (e) {
      debugPrint('🔍 [PHONG_TT_KCC] EXCEPTION: $e');
      if (mounted) {
        setState(() {
          _loading = false;
          _error = e.toString();
        });
      }
    }
  }

  /// Đổi nguồn API và reload
  Future<void> _changeSource(PhongTTApiSource newSource) async {
    if (newSource == _selectedSource) return;
    setState(() {
      _selectedSource = newSource;
      _allPatients = [];
      _apiSource = '⏳ Đang chuyển sang ${newSource.label}...';
    });
    await _saveSource(newSource);
    await _loadData();
  }

  /// Hiện bottom sheet chọn API source
  Future<void> _showApiSourcePicker() async {
    final picked = await showModalBottomSheet<PhongTTApiSource>(
      context: context,
      backgroundColor: Colors.transparent,
      builder: (ctx) => Container(
        decoration: const BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
        ),
        padding: const EdgeInsets.fromLTRB(16, 12, 16, 16),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Center(
              child: Container(
                width: 40, height: 4, margin: const EdgeInsets.only(bottom: 12),
                decoration: BoxDecoration(color: Colors.grey.shade300, borderRadius: BorderRadius.circular(2)),
              ),
            ),
            const Row(
              children: [
                Icon(Icons.cloud, size: 20, color: Color(0xFFB71C1C)),
                SizedBox(width: 8),
                Text('Chọn nguồn API', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
              ],
            ),
            const SizedBox(height: 4),
            const Text('Lấy danh sách BN trong Phòng TT KCC từ nguồn nào:',
              style: TextStyle(color: Colors.black54, fontSize: 12)),
            const SizedBox(height: 12),
            ...PhongTTApiSource.values.map((s) {
              final selected = s == _selectedSource;
              return Container(
                margin: const EdgeInsets.only(bottom: 8),
                decoration: BoxDecoration(
                  color: selected ? const Color(0xFFFFEBEE) : Colors.grey.shade50,
                  borderRadius: BorderRadius.circular(8),
                  border: Border.all(
                    color: selected ? const Color(0xFFB71C1C) : Colors.grey.shade300,
                    width: selected ? 1.5 : 1,
                  ),
                ),
                child: ListTile(
                  onTap: () => Navigator.pop(ctx, s),
                  leading: Container(
                    width: 36, height: 36,
                    alignment: Alignment.center,
                    decoration: BoxDecoration(
                      color: selected ? const Color(0xFFB71C1C) : Colors.grey.shade300,
                      borderRadius: BorderRadius.circular(18),
                    ),
                    child: Text(s.label.substring(0, 1),
                      style: TextStyle(color: selected ? Colors.white : Colors.black54, fontSize: 16, fontWeight: FontWeight.bold)),
                  ),
                  title: Text(s.shortLabel, style: const TextStyle(fontWeight: FontWeight.w600)),
                  subtitle: Text(s.hint, style: const TextStyle(fontSize: 11)),
                  trailing: selected ? const Icon(Icons.check_circle, color: Color(0xFFB71C1C)) : null,
                ),
              );
            }),
            const SizedBox(height: 8),
            Text('💡 Mẹo: Dùng "Public 8080" nếu không ở BV (luôn chạy). Dùng "HIS Pro 1408" khi ở BV/LAN. Dùng "Proxy 9999" khi có VPN BV.',
              style: TextStyle(color: Colors.black45, fontSize: 11)),
          ],
        ),
      ),
    );
    if (picked != null) {
      await _changeSource(picked);
    }
  }

  /// v3.0.107: Dump sample response ra file local để debug
  Future<void> _dumpResponseToFile(PhongTTResult res) async {
    try {
      final dir = await getApplicationDocumentsDirectory();
      final f = File('${dir.path}/last_phong_tt_response.json');
      final buf = StringBuffer();
      buf.writeln('=== PHONG_TT_KCC DEBUG DUMP v3.0.107 ===');
      buf.writeln('Time: ${DateTime.now().toIso8601String()}');
      buf.writeln('Source: ${_selectedSource.name} (${_selectedSource.label})');
      buf.writeln('URL: ${res.apiUrl}');
      buf.writeln('Success: ${res.success}');
      buf.writeln('Message: ${res.message ?? ""}');
      buf.writeln('Count: ${res.patients.length}');
      if (res.patients.isNotEmpty) {
        buf.writeln('--- First 2 BNs ---');
        for (var i = 0; i < (res.patients.length < 2 ? res.patients.length : 2); i++) {
          buf.writeln('--- BN ${i + 1} ---');
          try {
            buf.writeln(const JsonEncoder.withIndent('  ').convert(res.patients[i]));
          } catch (e) {
            buf.writeln(res.patients[i].toString());
          }
        }
      }
      await f.writeAsString(buf.toString(), flush: true);
      debugPrint('🔍 [PHONG_TT_KCC] Dumped response to: ${f.path}');
    } catch (e) {
      debugPrint('🔍 [PHONG_TT_KCC] dump error: $e');
    }
  }

  /// v3.0.104: Helper lấy tên BN thông minh - thử nhiều field name
  /// Trả về Map {name, source} để biết tên lấy từ field nào
  Map<String, String> _pickPatientName(Map<String, dynamic> p) {
    // Thử theo thứ tự ưu tiên (Vietnamese có dấu trước)
    final candidates = <String>[
      'TDL_PATIENT_NAME',         // Có dấu (vd: HUỲNH HIÊN)
      'TDL_PATIENT_UNSIGNED_NAME', // Không dấu (vd: HUYNH HIEN)
      'VIR_PATIENT_NAME',
      'PATIENT_NAME',
      'tdl_patient_name',
      'patientName',
      'patient_name',
      'VIR_PATIENT_NAME__UNSIGN',
    ];
    for (final k in candidates) {
      final v = p[k];
      if (v != null && v.toString().trim().isNotEmpty) {
        return {'name': v.toString().trim(), 'source': k};
      }
    }
    return {'name': 'N/A', 'source': '(no name field)'};
  }

  @override
  Widget build(BuildContext context) {
    // Filter BN theo tên
    final q = _searchQuery.toLowerCase().trim();
    final filtered = q.isEmpty
        ? _allPatients
        : _allPatients.where((p) {
            final name = _pickPatientName(p)['name']!.toLowerCase();
            final code = (p['TDL_PATIENT_CODE'] ?? '').toString().toLowerCase();
            final tcode = (p['TDL_TREATMENT_CODE'] ?? '').toString().toLowerCase();
            return name.contains(q) || code.contains(q) || tcode.contains(q);
          }).toList();

    return Scaffold(
      backgroundColor: const Color(0xFFF5F7FA),
      appBar: AppBar(
        backgroundColor: const Color(0xFFB71C1C), // đỏ - phòng cấp cứu
        foregroundColor: Colors.white,
        leading: IconButton(
          icon: const Icon(Icons.arrow_back),
          onPressed: () => context.safePop(),
        ),
        title: Row(
          children: [
            const Icon(Icons.medical_services, size: 18),
            const SizedBox(width: 6),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(widget.roomName,
                      style: const TextStyle(fontSize: 14, fontWeight: FontWeight.bold)),
                  const Text('REQUEST_ROOM_ID: 39 (PTTT_KCC)',
                      style: TextStyle(fontSize: 10, color: Colors.white70)),
                ],
              ),
            ),
          ],
        ),
        actions: [
          // v3.0.107: Nút chọn API source
          IconButton(
            icon: const Icon(Icons.cloud),
            onPressed: _showApiSourcePicker,
            tooltip: 'Chọn API nguồn',
          ),
          // v3.0.104: Nút copy log path
          IconButton(
            icon: const Icon(Icons.bug_report),
            onPressed: _showLogDialog,
            tooltip: 'Debug log',
          ),
          IconButton(icon: const Icon(Icons.refresh), onPressed: _loadData, tooltip: 'Tải lại'),
        ],
      ),
      body: Column(
        children: [
          // Header gradient
          Container(
            width: double.infinity,
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 12),
            decoration: const BoxDecoration(
              gradient: LinearGradient(
                begin: Alignment.topLeft,
                end: Alignment.bottomRight,
                colors: [Color(0xFFB71C1C), Color(0xFFD32F2F)],
              ),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Text('BỆNH NHÂN TRONG PHÒNG',
                              style: TextStyle(color: Colors.white70, fontSize: 10, letterSpacing: 1)),
                          const SizedBox(height: 2),
                          Row(
                            crossAxisAlignment: CrossAxisAlignment.baseline,
                            textBaseline: TextBaseline.alphabetic,
                            children: [
                              Text('${filtered.length}',
                                  style: const TextStyle(color: Colors.white, fontSize: 28, fontWeight: FontWeight.bold)),
                              const SizedBox(width: 4),
                              Text('/ ${_allPatients.length} ca',
                                  style: const TextStyle(color: Colors.white70, fontSize: 14)),
                            ],
                          ),
                        ],
                      ),
                    ),
                    Container(
                      padding: const EdgeInsets.all(10),
                      decoration: BoxDecoration(color: Colors.white.withOpacity(0.15), shape: BoxShape.circle),
                      child: const Icon(Icons.people, color: Colors.white, size: 28),
                    ),
                  ],
                ),
                // v3.0.106: API source + thời gian sync (giống HomeScreen)
                if (_apiSource != null || _lastSynced != null) ...[
                  const SizedBox(height: 6),
                  Row(
                    children: [
                      const Icon(Icons.cloud, size: 11, color: Colors.white60),
                      const SizedBox(width: 4),
                      Expanded(
                        child: Text(
                          _apiSource ?? '',
                          style: const TextStyle(color: Colors.white60, fontSize: 10),
                          maxLines: 1, overflow: TextOverflow.ellipsis,
                        ),
                      ),
                      if (_lastSynced != null) ...[
                        const SizedBox(width: 8),
                        const Icon(Icons.access_time, size: 11, color: Colors.white60),
                        const SizedBox(width: 2),
                        Text(
                          '${_two(_lastSynced!.hour)}:${_two(_lastSynced!.minute)}:${_two(_lastSynced!.second)} ${_two(_lastSynced!.day)}/${_two(_lastSynced!.month)}/${_lastSynced!.year}',
                          style: const TextStyle(color: Colors.white60, fontSize: 10),
                        ),
                      ],
                    ],
                  ),
                ],
              ],
            ),
          ),

          // Error banner
          if (_error != null)
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(10),
