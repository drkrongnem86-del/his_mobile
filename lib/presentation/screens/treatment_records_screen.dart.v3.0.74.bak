// TreatmentRecordsScreen v3.0.74 - Hồ sơ điều trị
// Hiển thị danh sách HSĐT theo khoa, có thể xem chi tiết từng HSĐT
import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';
import 'package:his_mobile/core/services/department_service.dart';
import 'package:his_mobile/core/utils/mojibake_fixer.dart';
import 'package:his_mobile/core/utils/patient_name_helper.dart';
import 'package:his_mobile/data/api/thongke_auth_service.dart';
import 'package:his_mobile/data/local/clinical_notes_service.dart';
import 'package:his_mobile/data/local/icd10_library.dart';
import 'package:his_mobile/presentation/screens/view_medical_record_screen.dart';

class TreatmentRecordsScreen extends StatefulWidget {
  const TreatmentRecordsScreen({super.key});

  @override
  State<TreatmentRecordsScreen> createState() => _TreatmentRecordsScreenState();
}

class _TreatmentRecordsScreenState extends State<TreatmentRecordsScreen> {
  final ThongkeAuthService _auth = ThongkeAuthService();
  int _currentDeptIndex = 0;
  bool _loading = false;
  List<Map<String, dynamic>> _records = [];

  List<Map<String, dynamic>> get _departments {
    if (DepartmentService.instance.departments.isNotEmpty) {
      return DepartmentService.instance.departments;
    }
    return const [];
  }

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    if (_departments.isEmpty) return;
    setState(() {
      _loading = true;
      _records = [];
    });
    try {
      final dept = _departments[_currentDeptIndex];
      final deptId = dept['id'] as int?;
      final list = await _auth.fetchPatientsPublic(
        departmentCatalogId: deptId,
        length: 200,
      );
      if (!mounted) return;
      setState(() {
        _records = list ?? [];
        _loading = false;
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _records = [];
        _loading = false;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    final dept = _departments.isNotEmpty
        ? _departments[_currentDeptIndex]
        : {'name': 'Hồ sơ điều trị', 'code': ''};
    final username = _auth.currentUsername ?? 'nemk';

    return Scaffold(
      backgroundColor: Colors.grey[50],
      appBar: AppBar(
        backgroundColor: const Color(0xFF1565C0),
        foregroundColor: Colors.white,
        title: Row(
          children: [
            const Icon(Icons.folder, color: Colors.white, size: 22),
            const SizedBox(width: 8),
            Expanded(
              child: Text(
                'Hồ sơ điều trị - ${dept['name']}',
                style: const TextStyle(color: Colors.white, fontSize: 15),
                overflow: TextOverflow.ellipsis,
              ),
            ),
          ],
        ),
        actions: [
          IconButton(
            icon: const Icon(Icons.refresh, color: Colors.white),
            onPressed: _loading ? null : _load,
          ),
        ],
      ),
      body: Column(
        children: [
          // Khoa picker
          Container(
            padding: const EdgeInsets.all(8),
            color: Colors.white,
            child: Row(
              children: [
                const Icon(Icons.local_hospital, size: 16, color: Color(0xFF1565C0)),
                const SizedBox(width: 8),
                const Text('Khoa:', style: TextStyle(fontSize: 13, fontWeight: FontWeight.w600)),
                const SizedBox(width: 8),
                Expanded(
                  child: GestureDetector(
                    onTap: _showDeptPicker,
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
                      decoration: BoxDecoration(
                        color: const Color(0xFFE3F2FD),
                        borderRadius: BorderRadius.circular(6),
                      ),
                      child: Text(
                        '${dept['icon'] ?? '🏥'}  ${dept['name']}',
                        style: const TextStyle(fontSize: 13, color: Color(0xFF1565C0), fontWeight: FontWeight.w600),
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),
          Expanded(
            child: _loading
                ? const Center(child: CircularProgressIndicator())
                : _records.isEmpty
                    ? const Center(
                        child: Column(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            Icon(Icons.folder_off, size: 64, color: Colors.grey),
                            SizedBox(height: 8),
                            Text('Chưa có hồ sơ điều trị', style: TextStyle(color: Colors.grey)),
                          ],
                        ),
                      )
                    : ListView.builder(
                        padding: const EdgeInsets.all(8),
                        itemCount: _records.length,
                        itemBuilder: (ctx, i) {
                          final p = _records[i];
                          return _RecordCard(
                            patient: p,
                            onTap: () => _openRecord(p, dept, username),
                          );
                        },
                      ),
          ),
        ],
      ),
    );
  }

  void _showDeptPicker() {
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.white,
      builder: (ctx) => SafeArea(
        child: ListView.builder(
          shrinkWrap: true,
          itemCount: _departments.length,
          itemBuilder: (ctx, i) {
            final d = _departments[i];
            final isCur = i == _currentDeptIndex;
            return ListTile(
              leading: Text(d['icon']?.toString() ?? '🏥', style: const TextStyle(fontSize: 20)),
              title: Text(d['name']?.toString() ?? '',
                  style: TextStyle(
                    color: isCur ? const Color(0xFF1565C0) : Colors.black,
                    fontWeight: isCur ? FontWeight.bold : FontWeight.normal,
                  )),
              trailing: isCur ? const Icon(Icons.check_circle, color: Color(0xFF1565C0)) : null,
              onTap: () {
                Navigator.pop(ctx);
                setState(() => _currentDeptIndex = i);
                _load();
              },
            );
          },
        ),
      ),
    );
  }

  void _openRecord(Map<String, dynamic> patient, Map<String, dynamic> dept, String username) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => ViewMedicalRecordScreen(
          patient: patient,
          department: dept,
          username: username,
        ),
      ),
    );
  }
}

class _RecordCard extends StatelessWidget {
  final Map<String, dynamic> patient;
  final VoidCallback onTap;

  const _RecordCard({required this.patient, required this.onTap});

  String _g(String k1, [String? k2, String? k3]) {
    return (patient[k1] ?? patient[k2 ?? ''] ?? patient[k3 ?? ''] ?? '').toString();
  }

  @override
  Widget build(BuildContext context) {
    final name = capitalizeVietnameseName(PatientNameHelper.getName(patient));
    final code = _g('TDL_PATIENT_CODE', 'tdl_patient_code');
    final reqCode = _g('TDL_TREATMENT_CODE', 'treatment_code');
    final icd = _g('ICD_NAME', 'icd_name');
    final dob = _g('TDL_PATIENT_DOB', 'tdl_patient_dob');
    final gender = _g('TDL_PATIENT_GENDER_NAME', 'tdl_patient_gender_name');

    return Card(
      margin: const EdgeInsets.only(bottom: 8),
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(8),
        child: Padding(
          padding: const EdgeInsets.all(12),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  Container(
                    width: 40, height: 40,
                    decoration: BoxDecoration(
                      color: const Color(0xFF1565C0).withOpacity(0.1),
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: const Icon(Icons.person, color: Color(0xFF1565C0), size: 24),
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          name.isEmpty ? 'BN' : name,
                          style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 14),
                          maxLines: 1, overflow: TextOverflow.ellipsis,
                        ),
                        if (code.isNotEmpty)
                          Text('Mã BN: $code', style: const TextStyle(fontSize: 11, color: Colors.black87)),
                        if (reqCode.isNotEmpty)
                          Text('Mã ĐT: $reqCode', style: const TextStyle(fontSize: 11, color: Colors.indigo, fontWeight: FontWeight.w600)),
                      ],
                    ),
                  ),
                  const Icon(Icons.chevron_right, color: Colors.grey),
                ],
              ),
              if (icd.isNotEmpty) ...[
                const SizedBox(height: 6),
                Container(
                  padding: const EdgeInsets.all(6),
                  decoration: BoxDecoration(
                    color: const Color(0xFFFFF3E0),
                    borderRadius: BorderRadius.circular(4),
                  ),
                  child: Row(
                    children: [
                      const Icon(Icons.healing, size: 12, color: Colors.orange),
                      const SizedBox(width: 4),
                      Expanded(
                        child: Text(icd,
                            style: const TextStyle(fontSize: 11, color: Colors.black87, fontStyle: FontStyle.italic),
                            maxLines: 2, overflow: TextOverflow.ellipsis),
                      ),
                    ],
                  ),
                ),
              ],
              if (dob.isNotEmpty || gender.isNotEmpty)
                Padding(
                  padding: const EdgeInsets.only(top: 6),
                  child: Text(
                    [if (gender.isNotEmpty) gender, if (dob.isNotEmpty) dob.length > 10 ? dob.substring(0, 10) : dob].join(' • '),
                    style: const TextStyle(fontSize: 11, color: Colors.black54),
                  ),
                ),
            ],
          ),
        ),
      ),
    );
  }
}
