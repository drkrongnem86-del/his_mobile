# ==========================================
# HIS Mobile specific
# ==========================================

# Build scripts (chỉ giữ script của version hiện tại, các version cũ để local)
# Khi push lên GitHub, ignore luôn để repo gọn
# Nếu muốn track, đổi comment:
# !_build_v362.py
# !_backup_v362.bat
# !restore_v362.bat
_build_v3*.py
!_build_v362.py
_backup_v3*.bat
!_backup_v362.bat
restore_v3*.bat
!restore_v362.bat

# Python scripts (test, scan, etc.)
_test_*.py
_check_*.py
_scan_*.py
_dump_*.py
_find_*.py
_fix_*.py
_add_*.py
_update_*.py
_build_v3*.py.bak

# Local app data
.dart_tool/
.flutter-plugins
android/.gradle/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.podspec
ios/Flutter/Flutter.framework
ios/Flutter/flutter_export_environment.sh

# Build artifacts (moved aside during cleanup)
.dart_tool_old/
android/.gradle_old/
build_old/

# Build logs (transient - keep only current in repo)
build_log_v*.txt

# Backup/OLD files (renamed with _ prefix to skip Dart import)
lib/presentation/screens/_*.dart
lib/presentation/screens/_*.bak
lib/**/_*.dart
lib/**/_*.bak
# v3.0.118: Android release keystore (KHONG commit - bao mat)
android/app/*.jks
android/app/*.keystore
# v3.0.183: Release keystore ở root level (khi build dev local, copy tu D:\tool\)
android/*.jks
android/*.keystore

